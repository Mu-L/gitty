{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    "src/plugins/**/*.ts",
    "src/plugins/**/*.tsx",
    "test/panes.test.ts",
    "test/nav.test.ts"
  ],
  // The mirror of the node project's exclusion: a plugin's `main/` half opens
  // files and talks to Electron, and has no business in a DOM project.
  "exclude": ["src/plugins/*/main/**"]
}
